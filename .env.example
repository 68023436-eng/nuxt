# ============================================================================
# ตัวอย่าง environment variables สำหรับโปรเจ็กต์ (คัดลอกไปเป็น .env แล้วเติมค่าจริง)
# อย่า Commit ไฟล์ .env ขึ้น git — เก็บเป็น secret เสมอ
# ============================================================================

# ---- Supabase (รองรับทั้งชื่อ NUXT_PUBLIC_ และชื่อสั้น) ----
# Public URL ของโปรเจ็กต์ Supabase (found in Supabase Dashboard -> Project Settings -> API)
NUXT_PUBLIC_SUPABASE_URL=

# Public "anon" key (public เฉพาะ — ใช้ใน client-side; ความปลอดภัยขึ้นกับ Row Level Security)
NUXT_PUBLIC_SUPABASE_KEY=

# Service role key (SECRET — ใช้สร้าง/แก้/ลบ auth user ฝั่ง server เท่านั้น ต้องไม่รั่วไป client)
# ทดแทนชื่อเก่า: SUPABASE_SERVICE_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY
NUXT_SUPABASE_SECRET_KEY=

# ---- Session (บังคับ) ----
# ใช้เซ็นต์ cookie `hc_access` ถ้าไม่ตั้ง server จะปฏิเสธการเข้า/ออกระบบ (ป้องกัน session forgery)
# ควรใช้ค่า random ยาว: `openssl rand -hex 32`
SESSION_SECRET=

# ---- Cron / Admin (บังคับสำหรับการล้างข้อมูล) ----
# ใช้ตรวจสอบสิทธิ์เรียก /api/cleanup/purge (ลบข้อมูลที่หมดอายุ)
# ควรใช้ค่า random ยาว: `openssl rand -hex 32`
CRON_SECRET=

# ---- ฐานข้อมูลโดยตรง (ถ้าใช้ scripts ภายนอกเท่านั้น ไม่ได้ถูกเรียกจากแอป) ----
DATABASE_URL=

# หมายเหตุ: ใน development HTTP ระบบจะยังทำงานได้ (cookie secure อัตโนมัติเมื่อเป็น HTTPS)
# ใน production ต้องเสิร์ฟผ่าน HTTPS เท่านั้น เพื่อให้ `Secure` cookie + HSTS ทำงานเต็มรูปแบบ